{
  "apiVersion": 1,
  "id": "at365.windows-tools",
  "name": "Applet.WindowsTools.at365",
  "displayName": "WindowsTools.at365",
  "version": "0.1.5",
  "minimumHostVersion": "0.36.8",
  "updateRepository": "5ynonym/Applet.WindowsTools.at365",
  "runtime": "dotnet",
  "entry": "Applet.WindowsTools.at365.dll",
  "type": "Applets.WindowsTools.WindowsToolsApplet",
  "description": "ウィンドウの移動・高さ調整・最小化・最大化・復元・終了、アプリのフォルダー表示、消灯予約、キー送信、無操作時の自動ロック。",
  "capabilities": [
    "ui",
    "settings",
    "dynamic-commands",
    "appdock-api"
  ],
  "settings": [
    {
      "key": "displayOffSeconds",
      "automation": true,
      "title": "ディスプレイが消灯するまでの秒数",
      "type": "number",
      "default": 5,
      "minimum": 1,
      "maximum": 3600,
      "step": 1,
      "description": "消灯コマンドからの待ち時間。再実行すると予約し直します。"
    },
    {
      "key": "autoLockEnabled",
      "title": "無操作時の自動ロック",
      "type": "boolean",
      "default": false,
      "description": "マウスとキーボードの操作がない場合にロックします。有効にした時点から監視します。"
    },
    {
      "key": "autoLockMinutes",
      "title": "自動ロックまでの無操作時間（分）",
      "type": "number",
      "default": 360,
      "minimum": 1,
      "maximum": 1440,
      "step": 1,
      "description": "1〜1440分。変更時には監視時間をリセットします。"
    },
    {
      "key": "shortcuts",
      "title": "ショートカットキーの送信",
      "type": "shortcut-list",
      "default": [],
      "description": "最大32件。ID・名前・送信キーを追加して保存すると、起動中のコマンド一覧へ反映します。IDは小文字英数字とハイフンで指定してください。"
    }
  ],
  "settingSections": [
    {
      "id": "display",
      "title": "ディスプレイ",
      "description": "消灯コマンドを実行したあとの待ち時間です。",
      "settings": [
        "displayOffSeconds"
      ]
    },
    {
      "id": "lock",
      "title": "自動ロック",
      "description": "PCを操作していないときのロックを設定します。",
      "settings": [
        "autoLockEnabled",
        "autoLockMinutes"
      ]
    },
    {
      "id": "keys",
      "title": "キー送信コマンド",
      "description": "よく使うキー操作をコマンドとして登録できます。",
      "settings": [
        "shortcuts"
      ]
    }
  ],
  "commands": [
    {
      "id": "at365.windows-tools.open-folder",
      "title": "最前面アプリの実行ファイルのフォルダーを開く"
    },
    {
      "id": "at365.windows-tools.display-off",
      "title": "ディスプレイの消灯を予約"
    },
    {
      "id": "at365.windows-tools.cancel-display-off",
      "title": "ディスプレイの消灯予約を取り消す"
    },
    {
      "id": "at365.windows-tools.toggle-auto-lock",
      "title": "無操作時の自動ロックを切り替える"
    },
    {
      "id": "at365.windows-tools.left",
      "title": "ウィンドウを左へ移動"
    },
    {
      "id": "at365.windows-tools.right",
      "title": "ウィンドウを右へ移動"
    },
    {
      "id": "at365.windows-tools.full-height",
      "title": "ウィンドウを上下いっぱいに広げる"
    },
    {
      "id": "at365.windows-tools.center",
      "title": "ウィンドウを画面中央へ移動"
    },
    {
      "id": "at365.windows-tools.minimize",
      "title": "ウィンドウを最小化"
    },
    {
      "id": "at365.windows-tools.maximize",
      "title": "ウィンドウを最大化"
    },
    {
      "id": "at365.windows-tools.restore",
      "title": "ウィンドウを元のサイズに戻す"
    },
    {
      "id": "at365.windows-tools.close",
      "title": "ウィンドウを閉じる"
    }
  ]
}
